    {
      "id": "JIZTkL835DB15kUdaxsUx",
      "type": "text",
      "x": 490.132177456928,
      "y": 1140.2130072126831,
      "width": 911.7092666983847,
      "height": 163.28183641565116,
      "angle": 0.0037610683532518507,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3B",
      "roundness": null,
      "seed": 1908410568,
      "version": 3460,
      "versionNonce": 1848432878,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792346797708,
      "created": 1792340078438,
      "link": null,
      "locked": false,
      "text": "En Grupo Vulpis nos especializamos en identificar, evaluar y conectar\n terrenos estratégicos en Lima Metropolitana, generando oportunidades \nde desarrollo inmobiliario rentables y sostenibles. Brindamos un servicio \ntransparente, ágil y enfocado en maximizar el valor para nuestros clientes e\ninversionistas.",
      "fontSize": 26.125093826504184,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "En Grupo Vulpis nos especializamos en identificar, evaluar y conectar\n terrenos estratégicos en Lima Metropolitana, generando oportunidades \nde desarrollo inmobiliario rentables y sostenibles. Brindamos un servicio \ntransparente, ágil y enfocado en maximizar el valor para nuestros clientes e inversionistas.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JA3GbkNpVttpZEMKHtJTs",
      "type": "text",
      "x": 1062.1651684160051,
      "y": 1532.6425479467568,
      "width": 726.6863401827966,
      "height": 122.79579375728537,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
