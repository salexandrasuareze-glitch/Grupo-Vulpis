      "version": 885,
      "versionNonce": 916508758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793470735502,
      "created": 1792340501726,
      "link": null,
      "locked": false,
      "text": "Ser una empresa referente en el sector inmobiliario peruano,\nreconocida por su capacidad para detectar oportunidades de alto\npotencial y por construir relaciones sólidas basadas en confianza,\ninnovación y resultados",
      "fontSize": 24.559158751457073,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ser una empresa referente en el sector inmobiliario peruano, reconocida por su capacidad para detectar oportunidades de alto potencial y por construir relaciones sólidas basadas en confianza, innovación y resultados",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
